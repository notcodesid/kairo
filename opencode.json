{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "experiential": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "claude-fable-5.1": {
          "name": "Claude Fable 5.1"
        }
      }
    },
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "options": {
        "baseURL": "https://co.agentrouter.org/v1"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        }
      }
    }
  },
  "model": "experiential/deepseek-v4-flash"
}
