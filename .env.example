# Copy to .env / .env.local and fill values. Never commit real keys.
# NEXT_PUBLIC_* is baked at build time — redeploy after changing in Vercel.

# Mainnet proving (old direct prover — leave unset until StarkWare publishes)
NEXT_PUBLIC_PROVING_URL_MAINNET=
# Server fallback for same (optional)
PROVING_SERVICE_URL_MAINNET=

# Starkscan relay (new mainnet path — server-only, never NEXT_PUBLIC_)
STARKSCAN_API_KEY=
# Public Key ID only — this is what goes in the whitelist sheet, not the secret
STARKSCAN_KEY_ID=
# Relay base (override only if Starkscan moves the prover route)
STARKSCAN_RELAY_BASE=https://api.starkscan.co/v1/SN_MAIN/prove

# Mainnet RPC (proof-capable: zan default; fallback mainnet.nodes.starknet.org)
NEXT_PUBLIC_RPC_URL_MAINNET=https://api.zan.top/public/starknet-mainnet/rpc/v0_10
# Pinned serializer spec — must be <= starknet_specVersion of the RPC above
NEXT_PUBLIC_RPC_SPEC_MAINNET=0.10.3
# Sepolia RPC + proving (public defaults, override if endpoints move)
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://api.cartridge.gg/x/starknet/sepolia
NEXT_PUBLIC_PROVING_URL_SEPOLIA=https://transaction-prover.alpha-sepolia.sw-dev.io

# Pool contracts (override on redeploy)
NEXT_PUBLIC_POOL_ADDRESS_MAINNET=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
NEXT_PUBLIC_POOL_ADDRESS_SEPOLIA=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Explorer links (display only)
NEXT_PUBLIC_EXPLORER_MAINNET=https://voyager.online
NEXT_PUBLIC_EXPLORER_SEPOLIA=https://sepolia.voyager.online

# Sponsored SDK submits via AVNU (server-only, optional)
PAYMASTER_API_KEY=

# Local script override for verify-txs.mjs (optional, leave unset)
# RPC_URL_OVERRIDE=
