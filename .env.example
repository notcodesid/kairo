# Copy to .env / .env.local and fill values. Never commit real keys.
# NEXT_PUBLIC_* is baked at build time — redeploy after changing in Vercel.

# Mainnet proving (old direct prover — leave unset until StarkWare publishes)
NEXT_PUBLIC_PROVING_URL_MAINNET=
# Server fallback for same (optional)
PROVING_SERVICE_URL_MAINNET=

# Starkscan relay (new mainnet path — server-only, never NEXT_PUBLIC_)
STARKSCAN_API_KEY=
# Public Key ID only — this is what goes in the whitelist sheet, not the secret
STARKSCAN_KEY_ID=

# Sponsored SDK submits via AVNU (server-only, optional)
PAYMASTER_API_KEY=
